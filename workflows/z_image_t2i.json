{
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default" }, "_meta": { "title": "Z-Image Turbo" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default" }, "_meta": { "title": "Qwen3-4B 文本编码器" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "ae.safetensors" }, "_meta": { "title": "VAE" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "{{PROMPT}}" }, "_meta": { "title": "正向提示词" } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "" }, "_meta": { "title": "负向提示词" } },
  "6": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3 }, "_meta": { "title": "采样偏移" } },
  "7": { "class_type": "EmptySD3LatentImage", "inputs": { "width": 1280, "height": 720, "batch_size": 1 }, "_meta": { "title": "空潜空间" } },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["6", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["7", 0]
    },
    "_meta": { "title": "采样（turbo 8 步）" }
  },
  "9": { "class_type": "VAEDecode", "inputs": { "samples": ["8", 0], "vae": ["3", 0] }, "_meta": { "title": "解码" } },
  "10": { "class_type": "SaveImage", "inputs": { "images": ["9", 0], "filename_prefix": "openreel/keyframe" }, "_meta": { "title": "保存" } }
}
